<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EVA.Desktop.ViewModels"
             xmlns:models="using:EVA.Desktop.Models"
             x:Class="EVA.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Contas Conectadas" FontSize="22" FontWeight="Bold" Foreground="#FAFAFA" />
                <TextBlock Text="Gerencie caixas de entrada corporativas e pessoais monitoradas simultaneamente pela EVA."
                           FontSize="13" Foreground="#A1A1AA" />
            </StackPanel>
            <Button Grid.Column="1" Content="↻ Atualizar" Classes="Secondary"
                    Command="{Binding LoadCommand}" VerticalAlignment="Center" />
        </Grid>

        <!-- Add Account Card -->
        <Border Grid.Row="1" Classes="Card">
            <StackPanel Spacing="12">
                <TextBlock Text="Adicionar Nova Conta" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                <Grid ColumnDefinitions="2*,1.5*,1.2*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" PlaceholderText="E-mail (ex: usuario@estapar.com.br)" Text="{Binding NewEmail}" />
                    <TextBox Grid.Column="1" PlaceholderText="Apelido (ex: Estapar)" Text="{Binding NewDisplayName}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ProviderOptions}" SelectedIndex="{Binding SelectedProviderIndex}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="3" Content="+ Cadastrar" Classes="Primary" Command="{Binding AddAccountCommand}" />
                </Grid>

                <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="10">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="13" />
                </Border>
                <Border IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="10">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Accounts List -->
        <Border Grid.Row="2" Classes="Card">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:EmailAccountDto">
                            <Border Background="#111114" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <Border Background="#27272A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProviderLabel}" FontSize="10" Foreground="#D4D4D8" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Email}" FontSize="13" Foreground="#818CF8" />
                                        <TextBlock Text="{Binding LastSyncFormatted}" FontSize="11" Foreground="#71717A" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Ativar / Pausar" Classes="Secondary"
                                                Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).ToggleAccountCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Remover" Classes="Secondary"
                                                Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).DeleteAccountCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
